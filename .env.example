# Server Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# CORS
CORS_ORIGIN=*

# PostgreSQL Database URL
DATABASE_URL="postgresql://username:password@localhost:5432/dbname?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# File Uploads
UPLOAD_DIR="uploads"
