# Project Identity
APP_NAME=my-fastify-api

# Server Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
TRUST_PROXY=true

# Security & CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW="1 minute"

# PostgreSQL Database URL
DATABASE_URL="postgresql://username:password@localhost:5432/dbname?schema=public"

# JWT Authentication (Required: minimum 16 characters)
JWT_ACCESS_SECRET="generate-a-strong-secret-key-at-least-16-characters"
JWT_EXPIRES_IN="7d"

# Storage & Uploads
UPLOAD_DIR="uploads"
